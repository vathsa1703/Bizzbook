# Required for local startup. Render supplies PORT automatically.
PORT=5003
JWT_SECRET=replace-with-a-long-random-local-secret

# PostgreSQL connection. Set either DATABASE_URL or all PG* values below.
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# PGHOST=localhost
# PGPORT=5433
# PGUSER=bizbook
# PGPASSWORD=replace-with-local-password
# PGDATABASE=bizbook_dev

# Optional AI configuration. Without a provider key, AI features use fallback behavior.
OPENAI_API_KEY=replace-with-provider-api-key
OPENAI_BASE_URL=https://api.groq.com/openai/v1
CHAT_MODEL=openai/gpt-oss-120b
WHISPER_MODEL=whisper-large-v3

# Used when generating invitation links.
FRONTEND_URL=http://localhost:5173
