PORT=5003

JWT_SECRET=your-strong-secret-here

# SQLite file path. Optional — defaults to backend/data/business.db if unset. On a
# platform with a persistent disk (e.g. Render), set this to an ABSOLUTE path on the
# mounted disk, e.g. /data/business.db. Will be replaced by DATABASE_URL when this
# project migrates to PostgreSQL — see docs/postgres-migration-checklist.md.
# DB_PATH=/data/business.db

# Postgres migration (Phase 0 — not yet used by getDb()/db.js, only by the standalone
# connection-proof script). Matches docker-compose.yml's dev credentials. Host port is
# 5433 (not the default 5432) to avoid colliding with a native Postgres install on the
# same machine. Either set DATABASE_URL directly, or leave it unset and use the discrete
# PG* vars below.
# DATABASE_URL=postgres://bizbook:bizbook_dev_only@localhost:5433/bizbook_dev
# PGHOST=localhost
# PGPORT=5433
# PGUSER=bizbook
# PGPASSWORD=bizbook_dev_only
# PGDATABASE=bizbook_dev

# Public URL of the deployed frontend (used to build invite links). Defaults to
# http://localhost:5173 if unset.
FRONTEND_URL=http://localhost:5173

OPENAI_API_KEY=YOUR_API_KEY_HERE
OPENAI_BASE_URL=https://api.groq.com/openai/v1

CHAT_MODEL=llama-3.3-70b-versatile
WHISPER_MODEL=whisper-large-v3
