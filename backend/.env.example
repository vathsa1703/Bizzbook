PORT=5003

JWT_SECRET=your-strong-secret-here

# SQLite file path. Optional — defaults to backend/data/business.db if unset. On a
# platform with a persistent disk (e.g. Render), set this to an ABSOLUTE path on the
# mounted disk, e.g. /data/business.db. Will be replaced by DATABASE_URL when this
# project migrates to PostgreSQL — see docs/postgres-migration-checklist.md.
# DB_PATH=/data/business.db

# Public URL of the deployed frontend (used to build invite links). Defaults to
# http://localhost:5173 if unset.
FRONTEND_URL=http://localhost:5173

OPENAI_API_KEY=YOUR_API_KEY_HERE
OPENAI_BASE_URL=https://api.groq.com/openai/v1

CHAT_MODEL=llama-3.3-70b-versatile
WHISPER_MODEL=whisper-large-v3
